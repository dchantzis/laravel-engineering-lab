# Docker Compose environment (NOT the Laravel application/.env)
COMPOSE_PROJECT_NAME=laravel-engineering-lab
APP_IMAGE=laravel-engineering-lab:local
APP_PORT=8092
DB_PORT=33091
REDIS_PORT=6391
DB_DATABASE=laravel_engineering_lab
DB_USER=laravel
DB_PASSWORD=laravel-local-password
DB_ROOT_PASSWORD=root-local-password
XDEBUG_MODE=off
HOST_UID=1000
HOST_GID=1000