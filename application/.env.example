APP_NAME="Laravel Engineering Lab"
APP_ENV=local
APP_KEY=
APP_URL=http://localhost:8000

APP_DEBUG=true
APP_DEBUG_QUERIES=true
API_AUDIT_LOGS_ENABLED=true

APP_PRIVATE_KEY=
APP_INDEX_KEY=

APP_TIMEZONE=UTC
APP_VERSION=1.0
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=laravel_engineering_lab
DB_TRANSACTION_ATTEMPTS=3
# Write
DB_HOST=database
DB_PORT=3306
DB_DATABASE=laravel_engineering_lab
DB_USERNAME=laravel
DB_PASSWORD=laravel-local-password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
## Read
DB_HOST_READ="${DB_HOST}"
DB_PORT_READ="${DB_PORT}"
DB_DATABASE_READ="${DB_DATABASE}"
DB_USERNAME_READ="${DB_USERNAME}"
DB_PASSWORD_READ="${DB_PASSWORD}"
DB_TIMEZONE=UTC

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#Options: slack, teams, both
NOTIFICATION_CHANNEL=slack

LOG_SLACK_NOTIFICATIONS_ENABLED=true
LOG_TEAMS_NOTIFICATIONS_ENABLED=false
LOG_TEAMS_NOTIFICATIONS_WEBHOOK_TIMEOUT_SECONDS=10

LOG_SLACK_WEBHOOK_URL=
#LOG_SLACK_USERNAME=

PASSPORT_TOKENS_EXPIRE_IN_HOURS=1
PASSPORT_REFRESH_TOKENS_EXPIRE_IN_HOURS=24
PASSPORT_PERSONAL_ACCESS_TOKENS_EXPIRE_IN_HOURS=24

# Sensitive-data protection
SANITIZE_SENSITIVE_DATA=true
SANITIZE_API_DEBUG_INFORMATION=true
